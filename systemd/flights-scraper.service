# User unit: scrape whichever profiles are due, then publish. Started hourly by
# flights-scraper.timer.
# Assumes the repo is cloned at ~/stn-flight-scrape. Output is appended to
# logs/scrape.log (the Pi's journal is RAM-only, so it wouldn't survive a reboot).
[Unit]
Description=Scrape flight prices and publish the dashboard

[Service]
Type=oneshot
WorkingDirectory=%h/stn-flight-scrape
# User units can't order after network-online.target, so a catch-up run right after
# boot waits for DNS here instead of failing every request.
ExecStartPre=/bin/sh -c 'until getent hosts github.com >/dev/null; do sleep 5; done'
ExecStart=%h/stn-flight-scrape/scripts/run_and_deploy.sh
Environment=PYTHONUNBUFFERED=1
StandardOutput=append:%h/stn-flight-scrape/logs/scrape.log
StandardError=inherit
# A run of every profile is ~30 minutes of polite request delays; give a slow Pi
# plenty of slack.
TimeoutStartSec=2h
Nice=10
